# ── Sanity CMS ───────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"

# ── Site URL (used in email templates & PDF links) ────────────
NEXT_PUBLIC_SITE_URL="https://authorstranquilitypress.com"

# ── Resend (email delivery) ───────────────────────────────────
# Sign up at resend.com → add domain → copy API key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# ── Google Sheets — Leads (all form submissions) ──────────────
# Deploy an Apps Script Web App on your leads spreadsheet
GOOGLE_SHEETS_LEADS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# ── Download token signing secret ────────────────────────────
# Any long random string — used to sign one-time guide download tokens
DOWNLOAD_SECRET="replace-with-a-long-random-secret"

# ── Cloudflare Turnstile (spam protection) ────────────────────
# Sign up free at dash.cloudflare.com → Turnstile → Add site
# Choose widget type "Managed" for best UX (auto-verifies real users)
# Dev test keys (always pass): siteKey=1x00000000000000000000AA / secret=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your_turnstile_site_key"
TURNSTILE_SECRET_KEY="your_turnstile_secret_key"
